# --- PayPal Sandbox (Developer Dashboard -> Apps & Credentials -> Sandbox) ---
# https://developer.paypal.com/dashboard/applications/sandbox
# Leave both blank to run Pocket CFO fully in simulated mode (see README).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox base URL (use api-m.paypal.com for live)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Sandbox email of a receiver account for test Payouts (create one under
# Sandbox -> Accounts, or use the default personal sandbox account email).
# Used as the default receiver for all four pots.
PAYPAL_SANDBOX_PAYOUT_RECEIVER=sb-receiver@business.example.com

# Optional: send each pot's payouts to a different sandbox account instead
# of sharing PAYPAL_SANDBOX_PAYOUT_RECEIVER above (nice for the demo video —
# you can show four distinct sandbox inboxes filling up). Uncomment and
# fill in any you want to override; the rest fall back to the shared one.
# PAYPAL_POT_TAX_RECEIVER=
# PAYPAL_POT_REINVEST_RECEIVER=
# PAYPAL_POT_BUFFER_RECEIVER=
# PAYPAL_POT_TAKE_HOME_RECEIVER=

# Webhook ID from Developer Dashboard -> Apps -> Add Webhook (optional —
# only needed if you expose a public URL, e.g. via ngrok, for real webhooks.
# The demo also works without this via the "Simulate Payment" button.)
PAYPAL_WEBHOOK_ID=

# --- AI (optional) ---
# If unset, Pocket CFO automatically falls back to deterministic heuristics
# for risk scoring, reminder drafting, and discount negotiation — the app
# is fully demoable with zero AI keys configured.
ANTHROPIC_API_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/pocketcfo.sqlite
